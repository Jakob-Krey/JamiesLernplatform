---
import BaseLayout from '../layouts/BaseLayout.astro';
import { POKEMON_DATA } from '../data/pokemon';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="Jamies Pokémon-Arena ⚡ • Sammelalbum & Belohnungen" activePage="pokemon">
  <main class="container" style="padding-top: 2rem;">
    <div style="margin-bottom: 1.5rem;">
      <a href={`${base}/`} style="text-decoration: none; color: var(--color-primary); font-weight: 700; display: inline-flex; align-items: center; gap: 0.4rem;">
        <span>⬅️</span> Zurück <span data-profiles="jamie">zum Stundenplan</span><span data-profiles="maya">zum Start</span><span data-profiles="jakob">zum Timer</span>
      </a>
    </div>

    <!-- Trainer Header Card -->
    <div style="background: linear-gradient(135deg, #1e1b4b 0%, #312e81 100%); color: white; border-radius: 20px; padding: 1.25rem 1.75rem; box-shadow: var(--shadow-md); margin-bottom: 2rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
      <h1 style="font-size: 1.85rem; font-weight: 900; margin: 0;">
        Pokémon-Sammelalbum ⚡
      </h1>

      <div style="background: rgba(255, 255, 255, 0.12); backdrop-filter: blur(8px); border: 1px solid rgba(255, 255, 255, 0.2); border-radius: 12px; padding: 0.5rem 1.25rem; display: flex; align-items: center; gap: 0.75rem;">
        <span style="font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.05em; color: #fde68a; font-weight: 800;">
          Karten:
        </span>
        <span style="font-size: 1.5rem; font-weight: 900; color: white;" id="unlocked-counter">
          0 / 6
        </span>
        <span style="font-size: 0.85rem; font-weight: 800; color: #c7d2fe; border-left: 1px solid rgba(255,255,255,0.25); padding-left: 0.75rem;" id="other-counter"></span>
      </div>
    </div>

    <!-- Filter -->
    <div class="poke-filters">
      <div class="poke-filter-row" id="poke-view-chips">
        <button type="button" class="poke-chip active" data-view="all">Alle</button>
        <button type="button" class="poke-chip" data-view="mine">✅ Meine</button>
        <button type="button" class="poke-chip" data-view="locked">🔒 Noch nicht frei</button>
        <button type="button" class="poke-chip" data-view="fav">❤️ Favoriten</button>
      </div>
      <div class="poke-filter-row" id="poke-type-chips"></div>
      <div class="poke-filter-row">
        <input type="search" class="poke-search" id="poke-search" placeholder="🔍 Name suchen …" />
        <select class="poke-select" id="poke-sort" aria-label="Sortieren">
          <option value="dex">Sortiert nach Pokédex-Nr.</option>
          <option value="name">Sortiert nach Name</option>
          <option value="cost">Sortiert nach Preis</option>
        </select>
      </div>
    </div>

    <!-- Pokemon Cards Grid -->
    <div class="pokemon-grid" id="pokemon-collection"></div>
  </main>

  <!-- Modal for unlocking Pokémon -->
  <!-- Modal: Karte verschenken -->
  <div class="modal-overlay" id="gift-modal">
    <div class="modal-content" role="dialog" aria-modal="true" style="text-align: center;">
      <button type="button" class="modal-close-btn" id="close-gift-modal-btn">✕</button>
      <div id="gift-modal-body"></div>
    </div>
  </div>

  <div class="modal-overlay" id="unlock-modal">
    <div class="modal-content" role="dialog" aria-modal="true" style="text-align: center;">
      <button type="button" class="modal-close-btn" id="close-unlock-modal-btn">✕</button>
      <div id="unlock-modal-body"></div>
    </div>
  </div>
</BaseLayout>

<script>
  import { POKEMON_DATA, TYPE_LABELS, pokemonArtUrl, pokemonGifUrl, type PokemonCardData } from '../data/pokemon';
  import { StorageService } from '../lib/storage';
  import { FirebaseSync } from '../lib/firebase';
  import { pkey, currentProfile, otherProfiles } from '../lib/profile';
  import { AudioFX, triggerConfetti, showStarToast } from '../lib/audio';

  let targetPokeToUnlock: PokemonCardData | null = null;

  const FAV_KEY = pkey('jamie_favorite_pokemon');
  const me = currentProfile();
  const others = otherProfiles();
  const OTHER_KEY = (id: string) => `jamie_other_unlocked_${id}`;
  // Welche Karten das/die andere(n) Kind(er) besitzen (zuerst aus dem Zwischenspeicher, dann live aus der Cloud)
  const otherOwned: Record<string, string[]> = {};
  others.forEach((o) => {
    try {
      const cached = JSON.parse(localStorage.getItem(OTHER_KEY(o.id)) || '[]');
      otherOwned[o.id] = Array.isArray(cached) ? cached : [];
    } catch {
      otherOwned[o.id] = [];
    }
  });

  let view = 'all';
  let typeFilter = 'all';
  let sortBy = 'dex';
  let query = '';

  function getFavorites(): string[] {
    try {
      const parsed = JSON.parse(localStorage.getItem(FAV_KEY) || '[]');
      return Array.isArray(parsed) ? parsed : [];
    } catch {
      return [];
    }
  }

  function toggleFavorite(id: string) {
    const favs = getFavorites();
    const next = favs.includes(id) ? favs.filter((f) => f !== id) : [...favs, id];
    try {
      localStorage.setItem(FAV_KEY, JSON.stringify(next));
    } catch {}
  }

  function renderPokemonCollection() {
    const container = document.getElementById('pokemon-collection');
    if (!container) return;
    const unlockedIds = StorageService.getUnlockedPokemon();

    const counterEl = document.getElementById('unlocked-counter');
    if (counterEl) {
      counterEl.textContent = `${unlockedIds.length} / ${POKEMON_DATA.length}`;
    }
    container.innerHTML = '';
    const favs = getFavorites();

    const otherCounter = document.getElementById('other-counter');
    if (otherCounter) otherCounter.textContent = others.map((o) => `${o.emoji} ${o.name}: ${otherOwned[o.id].length}`).join('  ');

    const shown = POKEMON_DATA.filter((p) => {
      const unlocked = unlockedIds.includes(p.id);
      if (view === 'mine' && !unlocked) return false;
      if (view === 'locked' && unlocked) return false;
      if (view === 'fav' && !favs.includes(p.id)) return false;
      if (view.startsWith('other:') && !otherOwned[view.slice(6)]?.includes(p.id)) return false;
      if (typeFilter !== 'all' && p.type !== typeFilter) return false;
      if (query && !p.name.toLowerCase().includes(query)) return false;
      return true;
    });
    shown.sort((a, b) =>
      sortBy === 'name' ? a.name.localeCompare(b.name, 'de') : sortBy === 'cost' ? a.cost - b.cost || a.dex - b.dex : a.dex - b.dex
    );

    if (shown.length === 0) {
      container.innerHTML = '<div class="poke-empty">Keine Karten gefunden 🔍</div>';
    }

    shown.forEach(poke => {
      const isUnlocked = unlockedIds.includes(poke.id);
      const isFav = favs.includes(poke.id);
      const card = document.createElement('div');
      card.className = `pokemon-card ${isUnlocked ? '' : 'locked'}`;
      card.dataset.id = poke.id;
      
      card.innerHTML = `
        <div class="poke-owners" aria-hidden="true">
          ${isUnlocked ? `<span class="owner-chip" style="background:${me.color}" title="${me.name} hat die Karte">${me.name[0]}</span>` : ''}
          ${others.filter((o) => otherOwned[o.id].includes(poke.id)).map((o) => `<span class="owner-chip" style="background:${o.color}" title="${o.name} hat die Karte">${o.name[0]}</span>`).join('')}
        </div>
        ${isUnlocked && poke.cost > 0 && others.length > 0 ? `<button type="button" class="poke-gift" aria-label="Karte verschenken" title="Verschenken">🎁</button>` : ''}
        ${isUnlocked ? `<button type="button" class="poke-fav" aria-label="Favorit" aria-pressed="${isFav}">${isFav ? '❤️' : '🤍'}</button>` : ''}
        <div class="pokemon-card-inner ${poke.typeClass}">
          <div class="poke-card-header">
            <span class="poke-name">${poke.name}</span>
            <span class="poke-hp">${poke.hp}</span>
          </div>

          <div class="poke-image-frame">
            <span class="poke-rarity">${poke.rarity}</span>
            <div class="poke-icon-large"><img class="poke-art" src="${pokemonArtUrl(poke.dex)}" alt="${poke.name}" loading="lazy" onerror="this.outerHTML='${poke.icon}'" /></div>
          </div>

          <div class="poke-attack">
            <div class="attack-name">
              <span>${poke.attackName}</span>
              <span>${poke.attackDmg}</span>
            </div>
            <div class="attack-desc">${poke.attackDesc}</div>
          </div>
        </div>
        ${!isUnlocked ? `
          <div class="locked-badge">
            <div style="font-size: 1.5rem; margin-bottom: 0.25rem;">🔒</div>
            <div>Freischalten</div>
            <div style="color: #fde047; margin-top: 0.25rem;">⭐ ${poke.cost} Sterne</div>
          </div>
        ` : ''}
      `;

      card.querySelector('.poke-gift')?.addEventListener('click', (e) => {
        e.stopPropagation();
        openGiftModal(poke);
      });

      card.querySelector('.poke-fav')?.addEventListener('click', (e) => {
        e.stopPropagation();
        toggleFavorite(poke.id);
        renderPokemonCollection();
      });

      card.addEventListener('click', () => {
        if (!isUnlocked) {
          promptUnlock(poke);
        } else {
          AudioFX.playChime();
          triggerConfetti();
          showStarToast(0, `Glitzernde ${poke.name} Karte! ✨`);
          animateCard(card, poke, false);
        }
      });

      // 3D tilt tracking for mouse / touch
      card.addEventListener('mousemove', (e) => {
        if (!isUnlocked) return;
        const rect = card.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        const centerX = rect.width / 2;
        const centerY = rect.height / 2;
        const rotX = -((y - centerY) / centerY) * 12;
        const rotY = ((x - centerX) / centerX) * 12;
        card.style.transform = `perspective(1000px) rotateX(${rotX}deg) rotateY(${rotY}deg) scale3d(1.04, 1.04, 1.04)`;
      });

      card.addEventListener('mouseleave', () => {
        card.style.transform = '';
      });

      container.appendChild(card);
    });
  }

  /** Ersetzt das Artwork kurz durch das animierte GIF. */
  function animateCard(card: HTMLElement, poke: PokemonCardData, shiny: boolean) {
    const img = card.querySelector<HTMLImageElement>('.poke-art');
    if (img) {
      const artUrl = pokemonArtUrl(poke.dex);
      const gif = new Image();
      gif.onload = () => {
        img.src = gif.src + '?' + Date.now(); // GIF von vorn starten
        img.classList.add('is-animated');
        setTimeout(() => {
          img.src = artUrl;
          img.classList.remove('is-animated');
        }, 4000);
      };
      gif.src = pokemonGifUrl(poke.dex, shiny);
    }
  }

  /* ---------- Karten verschenken ---------- */
  function closeGiftModal() {
    document.getElementById('gift-modal')?.classList.remove('active');
  }

  function openGiftModal(poke: PokemonCardData) {
    const modal = document.getElementById('gift-modal');
    const body = document.getElementById('gift-modal-body');
    if (!modal || !body) return;
    body.innerHTML = `
      <div style="font-size: 3rem; margin-bottom: 0.25rem;">🎁</div>
      <h2 style="font-size: 1.6rem; font-weight: 900; color: #0f172a; margin-bottom: 0.4rem;">${poke.name} verschenken?</h2>
      <p style="color: #64748b; font-size: 0.95rem; margin-bottom: 1.1rem;">Die Karte wandert zu dem Kind, das du auswählst. Du hast sie danach nicht mehr.</p>
      <div id="gift-targets" style="display: flex; flex-direction: column; gap: 0.6rem; margin-bottom: 0.9rem;"></div>
      <p id="gift-msg" style="min-height: 1.3em; font-weight: 800; color: #b91c1c; margin: 0 0 0.75rem;"></p>
      <button type="button" class="btn-trainer btn-secondary" id="cancel-gift-btn" style="width: 100%; justify-content: center;">Abbrechen</button>
    `;
    const targets = body.querySelector('#gift-targets')!;
    const msg = body.querySelector('#gift-msg') as HTMLElement;
    others.forEach((o) => {
      const hasIt = otherOwned[o.id].includes(poke.id);
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'btn-trainer btn-primary';
      b.style.cssText = 'width: 100%; justify-content: center;';
      b.disabled = hasIt;
      b.textContent = hasIt ? `${o.emoji} ${o.name} hat die Karte schon` : `${o.emoji} An ${o.name} schenken`;
      b.addEventListener('click', async () => {
        msg.textContent = 'Wird verschenkt …';
        msg.style.color = '#475569';
        targets.querySelectorAll('button').forEach((x) => ((x as HTMLButtonElement).disabled = true));
        const ts = new Date().toISOString();
        const ok = await FirebaseSync.giftCard(me.docId, o.docId, poke.id, ts);
        if (!ok) {
          msg.textContent = 'Das hat nicht geklappt. Brauchst du Internet? Bitte später nochmal versuchen.';
          msg.style.color = '#b91c1c';
          targets.querySelectorAll('button').forEach((x) => ((x as HTMLButtonElement).disabled = false));
          return;
        }
        StorageService.applyGiftedAway(poke.id, ts);
        otherOwned[o.id] = [...otherOwned[o.id], poke.id];
        try {
          localStorage.setItem(OTHER_KEY(o.id), JSON.stringify(otherOwned[o.id]));
        } catch {}
        closeGiftModal();
        triggerConfetti();
        AudioFX.playSuccessFanfare();
        showStarToast(0, `${poke.name} gehört jetzt ${o.name}! 🎁`);
        renderPokemonCollection();
      });
      targets.appendChild(b);
    });
    body.querySelector('#cancel-gift-btn')!.addEventListener('click', closeGiftModal);
    modal.classList.add('active');
  }

  document.getElementById('close-gift-modal-btn')?.addEventListener('click', closeGiftModal);
  document.getElementById('gift-modal')?.addEventListener('click', (e) => {
    if (e.target === e.currentTarget) closeGiftModal();
  });

  function promptUnlock(poke: PokemonCardData) {
    targetPokeToUnlock = poke;
    const modal = document.getElementById('unlock-modal');
    const body = document.getElementById('unlock-modal-body');
    const starsAvailable = StorageService.getStars();
    if (!modal || !body) return;

    body.innerHTML = `
      <div style="font-size: 3.5rem; margin-bottom: 0.5rem;"><img src="${pokemonArtUrl(poke.dex)}" alt="${poke.name}" style="height: 110px; width: auto;" onerror="this.outerHTML='${poke.icon}'" /></div>
      <h2 style="font-size: 1.8rem; font-weight: 900; color: #0f172a; margin-bottom: 0.5rem;">
        ${poke.name} freischalten?
      </h2>
      <p style="color: #64748b; font-size: 0.95rem; margin-bottom: 1.5rem;">
        Diese Karte kostet <strong>${poke.cost} Sterne</strong>.<br>
        Du hast aktuell <strong>⭐ ${starsAvailable} Sterne</strong>.
      </p>

      ${starsAvailable >= poke.cost ? `
        <button type="button" class="btn-trainer btn-primary" id="confirm-unlock-btn" style="width: 100%; justify-content: center; margin-bottom: 0.75rem;">
          🎉 Jetzt für ${poke.cost} Sterne freischalten!
        </button>
      ` : `
        <div style="background: #fef2f2; color: #991b1b; padding: 0.85rem; border-radius: 12px; font-weight: 700; margin-bottom: 1rem;">
          Dir fehlen noch ${poke.cost - starsAvailable} Sterne! Übe etwas Mathe oder Englisch, um dir mehr Sterne zu verdienen. 🎒
        </div>
      `}

      <button type="button" class="btn-trainer btn-secondary" id="cancel-unlock-btn" style="width: 100%; justify-content: center;">
        Abbrechen
      </button>
    `;

    const confirmBtn = body.querySelector('#confirm-unlock-btn');
    if (confirmBtn) {
      confirmBtn.addEventListener('click', confirmUnlock);
    }

    const cancelBtn = body.querySelector('#cancel-unlock-btn');
    if (cancelBtn) {
      cancelBtn.addEventListener('click', closeUnlockModal);
    }

    modal.classList.add('active');
  }

  function confirmUnlock() {
    if (!targetPokeToUnlock) return;
    const stars = StorageService.getStars();
    if (stars >= targetPokeToUnlock.cost) {
      StorageService.addStars(-targetPokeToUnlock.cost);
      StorageService.unlockPokemon(targetPokeToUnlock.id);
      closeUnlockModal();
      triggerConfetti();
      AudioFX.playSuccessFanfare();
      showStarToast(0, `Juhu! ${targetPokeToUnlock.name} gehört jetzt dir! ⚡`);
      const unlocked = targetPokeToUnlock;
      renderPokemonCollection();
      // Shiny-Überraschung auf der frisch freigeschalteten Karte
      const newCard = document.querySelector<HTMLElement>(`.pokemon-card[data-id="${unlocked.id}"]`);
      if (newCard) animateCard(newCard, unlocked, true);
    }
  }

  function closeUnlockModal() {
    const modal = document.getElementById('unlock-modal');
    if (modal) modal.classList.remove('active');
  }

  const closeBtn = document.getElementById('close-unlock-modal-btn');
  if (closeBtn) closeBtn.addEventListener('click', closeUnlockModal);

  const modal = document.getElementById('unlock-modal');
  if (modal) {
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeUnlockModal();
    });
  }

  // Filter-Leiste
  const viewChips = document.getElementById('poke-view-chips')!;
  others.forEach((o) => {
    const b = document.createElement('button');
    b.type = 'button';
    b.className = 'poke-chip';
    b.dataset.view = `other:${o.id}`;
    b.textContent = `${o.emoji} Hat ${o.name}`;
    viewChips.appendChild(b);
  });
  const typeChips = document.getElementById('poke-type-chips')!;
  typeChips.innerHTML =
    `<button type="button" class="poke-chip active" data-type="all">Alle Typen</button>` +
    Object.entries(TYPE_LABELS)
      .map(([t, label]) => `<button type="button" class="poke-chip" data-type="${t}">${label}</button>`)
      .join('');

  function setActive(group: HTMLElement, el: HTMLElement) {
    group.querySelectorAll('.poke-chip').forEach((c) => c.classList.toggle('active', c === el));
  }
  document.getElementById('poke-view-chips')!.addEventListener('click', (e) => {
    const el = (e.target as HTMLElement).closest<HTMLElement>('.poke-chip');
    if (!el) return;
    view = el.dataset.view!;
    setActive(el.parentElement!, el);
    renderPokemonCollection();
  });
  typeChips.addEventListener('click', (e) => {
    const el = (e.target as HTMLElement).closest<HTMLElement>('.poke-chip');
    if (!el) return;
    typeFilter = el.dataset.type!;
    setActive(typeChips, el);
    renderPokemonCollection();
  });
  document.getElementById('poke-search')!.addEventListener('input', (e) => {
    query = (e.target as HTMLInputElement).value.trim().toLowerCase();
    renderPokemonCollection();
  });
  document.getElementById('poke-sort')!.addEventListener('change', (e) => {
    sortBy = (e.target as HTMLSelectElement).value;
    renderPokemonCollection();
  });

  renderPokemonCollection();

  // Karten des anderen Kindes aus der Cloud holen und live aktuell halten
  others.forEach((o) => {
    const apply = (data: any) => {
      const list = data && Array.isArray(data.unlockedPokemon) ? (data.unlockedPokemon as string[]) : [];
      otherOwned[o.id] = list;
      try {
        localStorage.setItem(OTHER_KEY(o.id), JSON.stringify(list));
      } catch {}
      renderPokemonCollection();
    };
    FirebaseSync.load(o.docId).then((d) => d && apply(d));
    FirebaseSync.subscribe(apply, o.docId);
  });
</script>
