---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="Jamies Deutsch 📖 • Aktuell nichts zu lernen" activePage="deutsch">
  <main class="container" style="padding-top: 2rem;">
    <div style="margin-bottom: 1.5rem;">
      <a href={`${base}/`} style="text-decoration: none; color: var(--color-primary); font-weight: 700; display: inline-flex; align-items: center; gap: 0.4rem;">
        <span>⬅️</span> Zurück zum Stundenplan
      </a>
    </div>

    <div style="text-align: center; max-width: 520px; margin: 3rem auto; background: white; border: 2px solid #e2e8f0; border-radius: 24px; padding: 2.5rem 1.5rem; box-shadow: var(--shadow-md);">
      <div style="font-size: 3.5rem; margin-bottom: 0.75rem;" aria-hidden="true">📖</div>
      <h1 style="font-size: 1.8rem; font-weight: 900; color: #0f172a; margin: 0 0 0.75rem;">
        Deutsch
      </h1>
      <p style="font-size: 1.15rem; font-weight: 700; color: #475569; margin: 0 0 0.5rem;">
        Hier musst du aktuell nichts lernen.
      </p>
      <p style="font-size: 0.95rem; color: #64748b; margin: 0;">
        Dein Schreiblernheft findest du bei den Lernzielen.
      </p>
      <a href={`${base}/lernziele/`} class="btn-trainer btn-primary" style="display: inline-flex; margin-top: 1.5rem; text-decoration: none;">
        🏔️ Zu den Lernzielen
      </a>
    </div>
  </main>
</BaseLayout>
