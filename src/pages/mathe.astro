---
import BaseLayout from "../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout
  title="Jamies Mathe-Dschungel 🔢 • Blitzrechnen & 1x1"
  activePage="mathe"
>
  <main class="container" style="padding-top: 2rem;">
    <div style="margin-bottom: 1.5rem;">
      <a
        href={`${base}/`}
        style="text-decoration: none; color: var(--color-primary); font-weight: 700; display: inline-flex; align-items: center; gap: 0.4rem;"
      >
        <span>⬅️</span> Zurück <span data-profiles="jamie">zum Stundenplan</span><span data-profiles="maya">zum Start</span>
      </a>
    </div>

    <div style="text-align: center; max-width: 650px; margin: 0 auto 1.5rem;">
      <h1
        style="font-size: 2rem; font-weight: 900; color: #0f172a; margin: 0 0 1rem;"
      >
        Kopfrechnen 🔢
      </h1>

      <div
        style="display: flex; justify-content: center; flex-wrap: wrap; gap: 0.5rem;"
        id="math-mode-selector"
      >
        <button type="button" class="switch-btn" data-profiles="maya" data-mode="mix_schwer"
          >🎯 Alles gemischt</button
        >
        <button type="button" class="switch-btn" data-profiles="maya" data-mode="plus_1000"
          >➕ Plus bis 1000</button
        >
        <button type="button" class="switch-btn" data-profiles="maya" data-mode="minus_1000"
          >➖ Minus bis 1000</button
        >
        <button type="button" class="switch-btn" data-profiles="maya" data-mode="mal_gross"
          >✖️ Malnehmen</button
        >
        <button type="button" class="switch-btn" data-profiles="maya" data-mode="geteilt"
          >➗ Geteilt</button
        >
        <button type="button" class="switch-btn" data-profiles="maya" data-mode="zehner"
          >🔟 Mal/Geteilt 10, 100, 1000</button
        >
        <button type="button" class="switch-btn" data-mode="einmaleins"
          >✖️ 1x1 Einmaleins</button
        >
        <button type="button" class="switch-btn" data-profiles="jamie" data-mode="mix_alles"
          >🎯 Alles gemischt</button
        >
        <button type="button" class="switch-btn" data-profiles="jamie" data-mode="plus_100"
          >➕ Plus bis 100</button
        >
        <button type="button" class="switch-btn" data-profiles="jamie" data-mode="minus_100"
          >➖ Minus bis 100</button
        >
        <button type="button" class="switch-btn" data-profiles="jamie" data-mode="mix_100"
          >🎯 Plus/Minus gemischt</button
        >
      </div>

      <!-- Optionen: Zehnerübergang (bis 100) -->
      <div id="carry-options" style="display: none; justify-content: center; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.75rem;">
        <button type="button" class="switch-btn active" data-carry="any">Alle Aufgaben</button>
        <button type="button" class="switch-btn" data-carry="no">Ohne Zehnerübergang</button>
        <button type="button" class="switch-btn" data-carry="yes">Mit Zehnerübergang</button>
      </div>

      <!-- Optionen: Reihe fürs Einmaleins -->
      <div id="row-options" style="display: none; justify-content: center; flex-wrap: wrap; gap: 0.4rem; margin-top: 0.75rem;">
        <span style="font-weight: 800; color: #64748b; align-self: center;">Reihe:</span>
        <button type="button" class="switch-btn active" data-row="0">Alle</button>
        {[2, 3, 4, 5, 6, 7, 8, 9, 10].map((n) => (
          <button type="button" class="switch-btn" data-row={n}>{n}er</button>
        ))}
      </div>
    </div>

    <!-- Math Game Box -->
    <div class="math-game-box">
      <div
        style="display: flex; justify-content: space-between; align-items: center;"
      >
        <span
          style="font-weight: 800; font-size: 0.85rem; color: #64748b; text-transform: uppercase;"
          id="task-mode-tag"
        >
          Rechnen
        </span>
        <span
          style="background: #fef3c7; color: #b45309; padding: 0.25rem 0.65rem; border-radius: 9999px; font-weight: 800; font-size: 0.85rem;"
          id="streak-counter"
        >
          🔥 Serie: 0
        </span>
      </div>

      <div class="math-equation" id="math-problem">7 + 5 = ?</div>

      <form class="math-answer-row" id="math-form" autocomplete="off">
        <input
          type="text"
          inputmode="numeric"
          pattern="[0-9]*"
          class="math-input"
          id="math-input"
          aria-label="Deine Antwort"
          placeholder="?"
        />
        <button type="submit" class="btn-trainer btn-primary" id="math-submit">✅ Prüfen</button>
      </form>
    </div>

    <!-- ====================================================================
         ERKLÄR RECHNUNGEN: Schritt-für-Schritt-Erklärungen zum Aufklappen
         ==================================================================== -->
    <section class="explain-section">
      <h2 class="explain-title">📚 Erklär Rechnungen</h2>
      <p class="explain-sub">Tippe auf ein Thema, um die Erklärung zu öffnen.</p>

      <details class="explain-card">
        <summary>
          <span class="explain-icon">➗</span>
          <span><b>Division mit Rest</b><small>Beispiel: 17 : 5</small></span>
        </summary>

        <div class="explain-body">
          <div class="explain-question">
            <span class="explain-label">Frage</span>
            <b class="question-task">17 : 5 = ?</b>
            <span class="question-text">Wie oft passt die <b>5</b> in die <b>17</b>, ohne drüber zu gehen?</span>
          </div>

          <!-- Bild: 17 Punkte, in Fünfer-Gruppen sortiert -->
          <div class="dots-demo" aria-label="17 Punkte: drei Gruppen mit je 5 Punkten und 2 Punkte übrig">
            {[1, 2, 3].map((g) => (
              <div class="dots-group">
                <div class="dots">{[1, 2, 3, 4, 5].map(() => <span class="dot" />)}</div>
                <small>{g}. Fünfer</small>
              </div>
            ))}
            <div class="dots-group rest">
              <div class="dots">{[1, 2].map(() => <span class="dot" />)}</div>
              <small>Rest</small>
            </div>
          </div>

          <div class="explain-step">
            <span class="step-nr">1</span>
            <div>
              <b>Die 5er-Reihe aufsagen</b>
              <ul class="times-list">
                <li>5 · 1 = 5</li>
                <li>5 · 2 = 10</li>
                <li class="fits">5 · 3 = 15 <em>passt, ganz nah dran! ✅</em></li>
                <li class="too-big">5 · 4 = 20 <em>zu groß ❌</em></li>
              </ul>
              <p>Die 5 passt also <b>3-mal</b> in die 17.</p>
            </div>
          </div>

          <div class="explain-step">
            <span class="step-nr">2</span>
            <div>
              <b>Was bleibt übrig?</b>
              <p class="calc">17 − 15 = <b>2</b></p>
              <p>Das ist der <b>Rest</b>.</p>
            </div>
          </div>

          <div class="explain-result">
            <span class="explain-label">Ergebnis</span>
            <span class="result-eq">17 : 5 = 3 R 2</span>
          </div>

          <div class="explain-check">
            <span class="explain-label">Probe</span>
            3 · 5 + 2 = 15 + 2 = 17 ✓
          </div>
        </div>
      </details>
    </section>
  </main>
</BaseLayout>

<style>
  .explain-section { max-width: 640px; margin: 2.5rem auto 3rem; }
  .explain-title { font-size: 1.6rem; font-weight: 900; color: #0f172a; margin: 0 0 0.2rem; text-align: center; }
  .explain-sub { text-align: center; color: var(--text-muted); font-weight: 600; margin: 0 0 1rem; }

  .explain-card { background: white; border: 2px solid #bfdbfe; border-radius: 20px; box-shadow: var(--shadow-md); overflow: hidden; }
  .explain-card + .explain-card { margin-top: 0.9rem; }
  .explain-card summary {
    list-style: none; cursor: pointer; display: flex; align-items: center; gap: 0.9rem;
    padding: 1rem 1.2rem; min-height: 44px; font-size: 1.15rem; color: #1e3a8a;
  }
  .explain-card summary::-webkit-details-marker { display: none; }
  .explain-card summary::after { content: '▾'; margin-left: auto; font-size: 1.3rem; transition: transform 0.2s; }
  .explain-card[open] summary::after { transform: rotate(180deg); }
  .explain-card summary b { display: block; font-weight: 900; }
  .explain-card summary small { display: block; color: #64748b; font-weight: 700; font-size: 0.85rem; }
  .explain-icon { font-size: 1.8rem; width: 48px; height: 48px; border-radius: 14px; background: #eff6ff; display: inline-flex; align-items: center; justify-content: center; flex: 0 0 auto; }

  .explain-body { padding: 0 1.2rem 1.3rem; display: flex; flex-direction: column; gap: 1rem; color: #1e293b; font-size: 1.05rem; line-height: 1.5; }
  .explain-body p { margin: 0.2rem 0 0; }
  .explain-label { display: inline-block; font-size: 0.75rem; font-weight: 900; text-transform: uppercase; letter-spacing: 0.05em; padding: 0.15rem 0.6rem; border-radius: 9999px; margin-right: 0.4rem; vertical-align: middle; }
  .explain-question { background: #eff6ff; border-radius: 14px; padding: 0.8rem 1rem; font-weight: 600; }
  .explain-question .explain-label { background: #2563eb; color: white; }
  .question-task { font-size: 1.6rem; font-weight: 900; color: #1e3a8a; font-variant-numeric: tabular-nums; vertical-align: middle; }
  .question-text { display: block; margin-top: 0.35rem; }

  .dots-demo { display: flex; flex-wrap: wrap; gap: 0.6rem; justify-content: center; }
  .dots-group { display: flex; flex-direction: column; align-items: center; gap: 0.3rem; }
  .dots-group small { font-weight: 800; color: #475569; font-size: 0.8rem; }
  .dots { display: flex; gap: 5px; padding: 0.5rem 0.6rem; border: 2px solid #93c5fd; border-radius: 12px; background: #eff6ff; }
  .dot { width: 18px; height: 18px; border-radius: 50%; background: #3b82f6; }
  .dots-group.rest .dots { border-color: #fca5a5; border-style: dashed; background: #fff1f2; }
  .dots-group.rest .dot { background: #ef4444; }
  .dots-group.rest small { color: #b91c1c; }

  .explain-step { display: flex; gap: 0.8rem; align-items: flex-start; }
  .step-nr { flex: 0 0 auto; width: 2rem; height: 2rem; border-radius: 50%; background: #0f172a; color: white; font-weight: 900; display: inline-flex; align-items: center; justify-content: center; }
  .times-list { list-style: none; padding: 0; margin: 0.4rem 0 0; display: flex; flex-direction: column; gap: 0.25rem; font-weight: 700; font-variant-numeric: tabular-nums; }
  .times-list li { padding: 0.25rem 0.7rem; border-radius: 10px; background: #f8fafc; }
  .times-list em { font-style: normal; font-weight: 800; margin-left: 0.4rem; font-size: 0.92rem; }
  .times-list .fits { background: #dcfce7; color: #166534; }
  .times-list .too-big { background: #fee2e2; color: #991b1b; }
  .calc { font-size: 1.25rem; font-weight: 800; font-variant-numeric: tabular-nums; }

  .explain-result { background: #fef3c7; border: 2px solid #fcd34d; border-radius: 14px; padding: 0.8rem 1rem; display: flex; align-items: center; flex-wrap: wrap; gap: 0.4rem; }
  .explain-result .explain-label { background: #d97706; color: white; }
  .result-eq { font-size: 1.6rem; font-weight: 900; color: #78350f; font-variant-numeric: tabular-nums; }
  .explain-check { background: #f0fdf4; border: 2px solid #86efac; border-radius: 14px; padding: 0.8rem 1rem; font-weight: 800; color: #166534; font-variant-numeric: tabular-nums; }
  .explain-check .explain-label { background: #16a34a; color: white; }
</style>

<script>
  import { StorageService } from "../lib/storage";
  import { currentProfile } from "../lib/profile";
  import { AudioFX, triggerConfetti, showStarToast } from "../lib/audio";

  let currentMode = currentProfile().mathDefault;
  let currentAnswer = 0;
  let streak = 0;
  let carryMode: "any" | "no" | "yes" = "any"; // Zehnerübergang (bis 100)
  let activeRow = 0; // 0 = alle Reihen

  function randInt(min: number, max: number): number {
    return Math.floor(Math.random() * (max - min + 1)) + min;
  }

  // Plus: Übergang, wenn die Einer zusammen mehr als 9 ergeben
  function makePlus100(): [number, number] {
    for (let i = 0; i < 200; i++) {
      const a = randInt(11, 89);
      const b = randInt(3, 99 - a);
      if (b < 3) continue;
      const carry = (a % 10) + (b % 10) > 9;
      if (carryMode === "any" || (carryMode === "yes") === carry) return [a, b];
    }
    return carryMode === "yes" ? [38, 27] : [34, 25];
  }

  // Minus: Übergang, wenn die Einer vom Subtrahenden größer sind
  function makeMinus100(): [number, number] {
    for (let i = 0; i < 200; i++) {
      const a = randInt(21, 99);
      const b = randInt(3, a - 2);
      const carry = a % 10 < b % 10;
      if (carryMode === "any" || (carryMode === "yes") === carry) return [a, b];
    }
    return carryMode === "yes" ? [91, 38] : [78, 35];
  }

  function updateOptionVisibility() {
    const is100 = ["plus_100", "minus_100", "mix_100"].includes(currentMode);
    const carryEl = document.getElementById("carry-options");
    const rowEl = document.getElementById("row-options");
    if (carryEl) carryEl.style.display = is100 ? "flex" : "none";
    if (rowEl) rowEl.style.display = currentMode === "einmaleins" ? "flex" : "none";
  }

  document.querySelectorAll<HTMLElement>("#carry-options [data-carry]").forEach((btn) => {
    btn.addEventListener("click", () => {
      carryMode = btn.dataset.carry as "any" | "no" | "yes";
      document.querySelectorAll("#carry-options .switch-btn").forEach((b) => b.classList.toggle("active", b === btn));
      streak = 0;
      updateStreak();
      generateProblem();
    });
  });

  document.querySelectorAll<HTMLElement>("#row-options [data-row]").forEach((btn) => {
    btn.addEventListener("click", () => {
      activeRow = Number(btn.dataset.row);
      document.querySelectorAll("#row-options .switch-btn").forEach((b) => b.classList.toggle("active", b === btn));
      streak = 0;
      updateStreak();
      generateProblem();
    });
  });

  function setMathMode(mode: string) {
    currentMode = mode;
    streak = 0;
    updateStreak();
    updateOptionVisibility();
    const buttons = document.querySelectorAll(
      "#math-mode-selector .switch-btn",
    );
    buttons.forEach((btn) => {
      if (btn.getAttribute("data-mode") === mode) btn.classList.add("active");
      else btn.classList.remove("active");
    });
    generateProblem();
  }

  const modeBtns = document.querySelectorAll("#math-mode-selector .switch-btn");
  modeBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      const mode = btn.getAttribute("data-mode");
      if (mode) setMathMode(mode);
    });
  });

  /** Schwere Aufgaben (4. Klasse): setzt currentAnswer und liefert den Aufgabentext. */
  function hardProblem(mode: string): string {
    if (mode === "plus_1000") {
      const a = randInt(120, 899);
      const b = randInt(110, 999 - a);
      currentAnswer = a + b;
      return `${a} + ${b} = ?`;
    }
    if (mode === "minus_1000") {
      const a = randInt(300, 999);
      const b = randInt(110, a - 100);
      currentAnswer = a - b;
      return `${a} - ${b} = ?`;
    }
    if (mode === "mal_gross") {
      const twoByTwo = Math.random() < 0.4;
      const a = twoByTwo ? randInt(11, 25) : randInt(12, 99);
      const b = twoByTwo ? randInt(11, 19) : randInt(3, 9);
      currentAnswer = a * b;
      return `${a} · ${b} = ?`;
    }
    if (mode === "geteilt") {
      const d = randInt(3, 12);
      const q = randInt(12, 99);
      currentAnswer = q;
      return `${d * q} : ${d} = ?`;
    }
    const n = randInt(2, 99);
    const f = [10, 100, 1000][randInt(0, 2)];
    if (Math.random() < 0.5) {
      currentAnswer = n * f;
      return `${n} · ${f} = ?`;
    }
    currentAnswer = n;
    return `${n * f} : ${f} = ?`;
  }

  function generateProblem() {
    let a: number, b: number, equationText: string;
    const modeTag = document.getElementById("task-mode-tag");

    // "Alles gemischt" (Jamie): Plus, Minus und Einmaleins durcheinander
    const mixed = currentMode === "mix_alles";
    const mode = mixed ? ["plus_100", "minus_100", "einmaleins"][randInt(0, 2)] : currentMode;

    if (mode === "mix_schwer") {
      const hard = ["plus_1000", "minus_1000", "mal_gross", "geteilt", "zehner"];
      const sub = hard[randInt(0, hard.length - 1)];
      equationText = hardProblem(sub);
      if (modeTag) modeTag.textContent = "Alles gemischt";
    } else if (["plus_1000", "minus_1000", "mal_gross", "geteilt", "zehner"].includes(mode)) {
      equationText = hardProblem(mode);
      if (modeTag) {
        modeTag.textContent =
          { plus_1000: "Plus bis 1000", minus_1000: "Minus bis 1000", mal_gross: "Malnehmen", geteilt: "Geteilt", zehner: "Mal/Geteilt 10, 100, 1000" }[mode] ?? "";
      }
    } else if (mode === "einmaleins") {
      const row = mixed ? 0 : activeRow;
      a = row === 0 ? randInt(2, 10) : row;
      b = randInt(1, 10);
      currentAnswer = a * b;
      // Bei einer gewählten Reihe gelegentlich als Tauschaufgabe zeigen (z. B. 7 · 4 statt 4 · 7)
      equationText = row !== 0 && Math.random() > 0.5 ? `${b} · ${a} = ?` : `${a} · ${b} = ?`;
      if (modeTag) modeTag.textContent = row === 0 ? "1x1 Einmaleins" : `${row}er-Reihe`;
    } else {
      const isPlus = mode === "plus_100" || (mode === "mix_100" && Math.random() > 0.5);
      if (isPlus) {
        [a, b] = makePlus100();
        currentAnswer = a + b;
        equationText = `${a} + ${b} = ?`;
      } else {
        [a, b] = makeMinus100();
        currentAnswer = a - b;
        equationText = `${a} - ${b} = ?`;
      }
      if (modeTag) {
        modeTag.textContent =
          mode === "plus_100" ? "Plus bis 100" : mode === "minus_100" ? "Minus bis 100" : "Plus/Minus bis 100";
      }
    }

    if (mixed && modeTag) modeTag.textContent = "Alles gemischt";

    const problemEl = document.getElementById("math-problem");
    if (problemEl) problemEl.textContent = equationText;

    const input = document.getElementById("math-input") as HTMLInputElement | null;
    if (input) {
      input.value = "";
      input.disabled = false;
      input.classList.remove("correct", "wrong");
      input.focus();
    }
  }

  function checkMathAnswer() {
    const input = document.getElementById("math-input") as HTMLInputElement | null;
    if (!input || input.disabled) return;
    const raw = input.value.trim();
    if (raw === "") return;

    if (Number(raw) === currentAnswer) {
      input.classList.add("correct");
      input.disabled = true;
      streak++;
      updateStreak();
      AudioFX.playChime();

      if (streak % 5 === 0) {
        StorageService.addStars(2);
        showStarToast(2, `${streak}er Serie! Du bist ein Mathe-Genie! 🌟`);
        triggerConfetti();
      } else {
        StorageService.addStars(1);
        showStarToast(1, "Richtig gerechnet! 🎯");
      }

      setTimeout(() => {
        generateProblem();
      }, 700);
    } else {
      input.classList.add("wrong");
      streak = 0;
      updateStreak();
      setTimeout(() => {
        input.classList.remove("wrong");
        input.select();
      }, 500);
    }
  }

  document.getElementById("math-form")?.addEventListener("submit", (e) => {
    e.preventDefault();
    checkMathAnswer();
  });

  function updateStreak() {
    const el = document.getElementById("streak-counter");
    if (el) el.textContent = `🔥 Serie: ${streak}`;
  }

  setMathMode(currentMode);
</script>
