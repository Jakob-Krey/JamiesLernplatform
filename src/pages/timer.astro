---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="Jamies Fokus-Timer ⏱️ • 15 Min Lernen & 5 Min Pause" activePage="timer">
  <main class="container" style="padding-top: 1.5rem; max-width: 600px; text-align: center;">

    <!-- Top Back Link -->
    <div class="focus-hide" style="margin-bottom: 1.25rem; text-align: left;">
      <a href={`${base}/`} style="text-decoration: none; color: var(--color-primary); font-weight: 700; display: inline-flex; align-items: center; gap: 0.4rem;">
        <span>⬅️</span> Zurück <span data-profiles="jamie">zum Stundenplan</span><span data-profiles="maya">zum Start</span>
      </a>
    </div>

    <!-- Mode Switcher -->
    <div class="focus-hide" style="display: inline-flex; background: #e2e8f0; padding: 0.35rem; border-radius: 9999px; gap: 0.35rem; margin-bottom: 2rem;">
      <button 
        type="button" 
        id="btn-mode-work"
        class="timer-tab-btn active"
        style="padding: 0.6rem 1.4rem; border: none; border-radius: 9999px; font-weight: 800; font-size: 0.95rem; cursor: pointer; transition: all 0.2s;"
      >
        🎯 15 Min Fokus
      </button>
      <button 
        type="button" 
        id="btn-mode-break"
        class="timer-tab-btn"
        style="padding: 0.6rem 1.4rem; border: none; border-radius: 9999px; font-weight: 800; font-size: 0.95rem; cursor: pointer; transition: all 0.2s; background: transparent; color: #475569;"
      >
        🍎 5 Min Pause
      </button>
    </div>

    <!-- Big Circular Timer Widget -->
    <div class="timer-circle-wrap" style="position: relative; width: 280px; height: 280px; margin: 0 auto 2rem;">
      <svg width="280" height="280" viewBox="0 0 280 280" style="transform: rotate(-90deg); filter: drop-shadow(0 10px 20px rgba(0,0,0,0.06));">
        <!-- Background Track -->
        <circle
          cx="140"
          cy="140"
          r="120"
          stroke="#f1f5f9"
          stroke-width="14"
          fill="white"
        />
        <!-- Progress Bar -->
        <circle
          id="timer-progress-circle"
          cx="140"
          cy="140"
          r="120"
          stroke="#3b82f6"
          stroke-width="14"
          stroke-linecap="round"
          stroke-dasharray="753.98"
          stroke-dashoffset="0"
          fill="transparent"
          style="transition: stroke-dashoffset 0.8s ease, stroke 0.3s ease;"
        />
      </svg>

      <!-- Center Countdown Info -->
      <div style="position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; pointer-events: none;">
        <span id="timer-mode-label" style="font-size: 0.95rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; color: #3b82f6; margin-bottom: 0.25rem;">
          🎯 FOKUSZEIT
        </span>
        <div id="timer-display" style="font-size: 3.8rem; font-weight: 900; color: #0f172a; font-variant-numeric: tabular-nums; line-height: 1;">
          15:00
        </div>
        <span id="timer-reward-badge" class="focus-hide" style="font-size: 0.85rem; font-weight: 800; color: #b45309; background: #fef3c7; padding: 0.2rem 0.65rem; border-radius: 9999px; margin-top: 0.6rem;">
          +2 Sterne Belohnung ⭐
        </span>
      </div>
    </div>

    <!-- Controls -->
    <div style="display: flex; justify-content: center; align-items: center; gap: 1rem; margin-bottom: 2.5rem;">
      <button 
        type="button" 
        id="btn-timer-reset"
        class="focus-hide"
        title="Zurücksetzen"
        style="width: 52px; height: 52px; border-radius: 50%; border: 2px solid #e2e8f0; background: white; font-size: 1.25rem; display: flex; align-items: center; justify-content: center; cursor: pointer; box-shadow: var(--shadow-sm); transition: transform 0.15s;"
      >
        🔄
      </button>

      <button 
        type="button" 
        id="btn-timer-toggle"
        class="btn-trainer btn-primary"
        style="font-size: 1.35rem; padding: 0.9rem 2.5rem; border-radius: 9999px; box-shadow: var(--shadow-md); min-width: 170px;"
      >
        ▶️ Start
      </button>

      <button 
        type="button" 
        id="btn-timer-skip"
        class="focus-hide"
        title="Zur Pause / Zum Lernen wechseln"
        style="width: 52px; height: 52px; border-radius: 50%; border: 2px solid #e2e8f0; background: white; font-size: 1.25rem; display: flex; align-items: center; justify-content: center; cursor: pointer; box-shadow: var(--shadow-sm); transition: transform 0.15s;"
      >
        ⏭️
      </button>
    </div>

    <p id="break-lock-hint" style="margin: -1rem 0 1.5rem; font-weight: 800; color: #047857;">
      🍎 Pausenzeit! Die Pause läuft bis zum Ende. Streck dich, trink etwas, atme durch.
    </p>

    <!-- Today's Focus Stats -->
    <div class="focus-hide" style="background: white; border: 2px solid #e2e8f0; border-radius: 16px; padding: 1rem 1.5rem; display: inline-flex; align-items: center; gap: 1rem; box-shadow: var(--shadow-sm);">
      <span style="font-size: 1.8rem;">🏆</span>
      <div style="text-align: left;">
        <div style="font-size: 0.8rem; font-weight: 800; color: #64748b; text-transform: uppercase;">Heute abgeschlossen</div>
        <div style="font-size: 1.15rem; font-weight: 900; color: #0f172a;" id="timer-completed-count">
          0 Fokus-Einheiten (+0 Sterne)
        </div>
      </div>
    </div>

  </main>
</BaseLayout>

<style is:global>
  /* Fokus läuft: alles ausblenden außer Timer und Pause-Knopf */
  body.focus-active .focus-hide,
  body.focus-active .site-header,
  body.focus-active .site-footer,
  body.focus-active .bg-decoration {
    display: none !important;
  }
  body.break-active #btn-timer-toggle { display: none !important; }
  #break-lock-hint { display: none; }
  body.break-active #break-lock-hint { display: block; }
  body.focus-active main {
    padding-top: 15vh !important;
  }
  .timer-tab-btn.active {
    background: white !important;
    color: #0f172a !important;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  }
  .timer-tab-btn:hover:not(.active) {
    color: #1e293b !important;
  }
  #btn-timer-reset:active, #btn-timer-skip:active {
    transform: scale(0.92);
  }
</style>

<script>
  import { FocusTimerService, type FocusTimerState } from '../lib/focusTimer';

  FocusTimerService.init();

  const CIRCLE_RADIUS = 120;
  const CIRCLE_CIRCUMFERENCE = 2 * Math.PI * CIRCLE_RADIUS; // ~753.98

  const displayEl = document.getElementById('timer-display');
  const modeLabelEl = document.getElementById('timer-mode-label');
  const rewardBadgeEl = document.getElementById('timer-reward-badge');
  const progressCircle = document.getElementById('timer-progress-circle');
  const toggleBtn = document.getElementById('btn-timer-toggle');
  const resetBtn = document.getElementById('btn-timer-reset');
  const skipBtn = document.getElementById('btn-timer-skip');
  const btnWork = document.getElementById('btn-mode-work');
  const btnBreak = document.getElementById('btn-mode-break');
  const completedEl = document.getElementById('timer-completed-count');

  function updateUI(state: FocusTimerState) {
    if (displayEl) {
      displayEl.textContent = FocusTimerService.formatTime(state.timeLeft);
    }

    // Läuft Fokus oder Pause: alles andere ausblenden. In der Pause gibt es zusätzlich keinen Pause-Knopf.
    document.body.classList.toggle('focus-active', state.isRunning);
    document.body.classList.toggle('break-active', state.isRunning && state.mode === 'break');

    if (toggleBtn) {
      toggleBtn.innerHTML = state.isRunning ? '⏸️ Pause' : '▶️ Start';
      if (state.isRunning) {
        toggleBtn.style.background = '#e11d48'; // red for pause
      } else {
        toggleBtn.style.background = state.mode === 'work' ? '#2563eb' : '#059669';
      }
    }

    // Colors & Labels
    const isWork = state.mode === 'work';
    if (modeLabelEl) {
      modeLabelEl.textContent = isWork ? '🎯 FOKUSZEIT' : '🍎 PAUSE';
      modeLabelEl.style.color = isWork ? '#2563eb' : '#059669';
    }

    if (rewardBadgeEl) {
      if (isWork) {
        rewardBadgeEl.textContent = '+2 Sterne Belohnung ⭐';
        rewardBadgeEl.style.display = 'inline-block';
      } else {
        rewardBadgeEl.textContent = 'Durchatmen & Entspannen 🌿';
        rewardBadgeEl.style.display = 'inline-block';
      }
    }

    if (btnWork && btnBreak) {
      if (isWork) {
        btnWork.classList.add('active');
        btnBreak.classList.remove('active');
      } else {
        btnBreak.classList.add('active');
        btnWork.classList.remove('active');
      }
    }

    // Circular progress
    if (progressCircle) {
      const fraction = state.totalDuration > 0 ? state.timeLeft / state.totalDuration : 0;
      const offset = CIRCLE_CIRCUMFERENCE * (1 - fraction);
      progressCircle.style.strokeDashoffset = offset.toString();
      progressCircle.setAttribute('stroke', isWork ? '#2563eb' : '#10b981');
    }

    // Completed stats
    if (completedEl) {
      const count = state.completedToday;
      const starsEarned = count * 2;
      completedEl.textContent = `${count} Fokus-Einheiten (+${starsEarned} Sterne)`;
    }
  }

  // Event Listeners
  toggleBtn?.addEventListener('click', () => {
    FocusTimerService.toggle();
    updateUI(FocusTimerService.getState());
  });

  resetBtn?.addEventListener('click', () => {
    FocusTimerService.reset();
    updateUI(FocusTimerService.getState());
  });

  skipBtn?.addEventListener('click', () => {
    const current = FocusTimerService.getState();
    FocusTimerService.setMode(current.mode === 'work' ? 'break' : 'work');
    updateUI(FocusTimerService.getState());
  });

  btnWork?.addEventListener('click', () => {
    FocusTimerService.setMode('work');
    updateUI(FocusTimerService.getState());
  });

  btnBreak?.addEventListener('click', () => {
    FocusTimerService.setMode('break');
    updateUI(FocusTimerService.getState());
  });

  // Listen for background ticks
  window.addEventListener('jamie-timer-tick', (e: any) => {
    updateUI(e.detail);
  });

  // Initial draw
  updateUI(FocusTimerService.getState());
</script>
