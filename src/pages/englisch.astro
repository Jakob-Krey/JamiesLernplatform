---
import BaseLayout from '../layouts/BaseLayout.astro';
import { VOCAB_DATA, VOCAB_CATEGORIES } from '../data/vocab';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="Jamies Englisch-Abenteuer 🇬🇧 • Vokabeltrainer" activePage="englisch">
  <main class="container" style="padding-top: 2rem;">
    <!-- Breadcrumb / Back Link -->
    <div style="margin-bottom: 1.5rem;">
      <a href={`${base}/`} style="text-decoration: none; color: var(--color-primary); font-weight: 700; display: inline-flex; align-items: center; gap: 0.4rem;">
        <span>⬅️</span> Zurück zum Stundenplan
      </a>
    </div>

    <!-- Header Section -->
    <div style="text-align: center; max-width: 650px; margin: 0 auto 1.5rem;">
      <h1 style="font-size: 2rem; font-weight: 900; color: #0f172a; margin: 0 0 1rem;">
        Englisch-Vokabeln 🇬🇧
      </h1>

      <!-- Category Filter Buttons -->
      <div style="display: flex; justify-content: center; flex-wrap: wrap; gap: 0.5rem;" id="category-filter-bar">
        {VOCAB_CATEGORIES.map((cat, idx) => (
          <button 
            type="button" 
            class:list={['switch-btn', { active: idx === 0 }]} 
            data-cat={cat.id}
          >
            {cat.label}
          </button>
        ))}
      </div>
    </div>

    <!-- Interactive Flashcard Area -->
    <div class="flashcard-container" id="vocab-card">
      <div class="flashcard-inner">
        <!-- Front of card -->
        <div class="flashcard-front">
          <div class="flashcard-category" id="card-cat-label">ANIMALS 🐾</div>
          <div class="flashcard-emoji" id="card-emoji">🐶</div>
          <div class="flashcard-word" id="card-en-word">Dog</div>
          <p class="flashcard-hint">Tippen zum Umdrehen</p>
          <button type="button" class="flashcard-audio-btn" id="card-audio-btn" title="Englisch vorlesen">
            🔊 Vorlesen
          </button>
        </div>

        <!-- Back of card -->
        <div class="flashcard-back">
          <div class="flashcard-category" style="color: #166534;">Deutsch</div>
          <div class="flashcard-emoji" id="card-back-emoji">🐶</div>
          <div class="flashcard-word" id="card-de-word" style="color: #166534;">Der Hund</div>
          <p class="flashcard-hint" style="color: #15803d;">Tippen zum Zurückdrehen</p>
        </div>
      </div>
    </div>

    <!-- Actions -->
    <div class="flashcard-actions">
      <button type="button" class="btn-trainer btn-secondary" id="en-prev-btn">
        ⬅️ Vorherige
      </button>
      <button type="button" class="btn-trainer btn-primary" id="en-known-btn">
        ⭐ Kann ich schon! ➔
      </button>
      <button type="button" class="btn-trainer btn-secondary" id="en-next-btn">
        Nächste ➡️
      </button>
    </div>
  </main>
</BaseLayout>

<script>
  import { VOCAB_DATA, type VocabCategoryId } from '../data/vocab';
  import { StorageService } from '../lib/storage';
  import { AudioFX, speakEnglish, triggerConfetti, showStarToast } from '../lib/audio';

  let activeCat: VocabCategoryId = 'tiere';
  let cardIdx = 0;

  function renderCurrentCard() {
    const card = document.getElementById('vocab-card');
    if (card) card.classList.remove('is-flipped');

    const items = VOCAB_DATA[activeCat];
    const current = items[cardIdx];

    const catEl = document.getElementById('card-cat-label');
    const emojiEl = document.getElementById('card-emoji');
    const wordEl = document.getElementById('card-en-word');
    const backEmojiEl = document.getElementById('card-back-emoji');
    const deWordEl = document.getElementById('card-de-word');

    if (catEl) catEl.textContent = activeCat.toUpperCase();
    if (emojiEl) emojiEl.textContent = current.emoji;
    if (wordEl) wordEl.textContent = current.en;
    if (backEmojiEl) backEmojiEl.textContent = current.emoji;
    if (deWordEl) deWordEl.textContent = current.de;
  }

  function setCategory(cat: VocabCategoryId) {
    activeCat = cat;
    cardIdx = 0;
    document.querySelectorAll('#category-filter-bar .switch-btn').forEach(btn => {
      if (btn.getAttribute('data-cat') === cat) btn.classList.add('active');
      else btn.classList.remove('active');
    });
    renderCurrentCard();
  }

  const catBtns = document.querySelectorAll('#category-filter-bar .switch-btn');
  catBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const cat = btn.getAttribute('data-cat') as VocabCategoryId;
      if (cat) setCategory(cat);
    });
  });

  const card = document.getElementById('vocab-card');
  if (card) {
    card.addEventListener('click', (e) => {
      // Don't flip if clicking the audio button
      if ((e.target as HTMLElement).closest('#card-audio-btn')) return;
      card.classList.toggle('is-flipped');
    });
  }

  const audioBtn = document.getElementById('card-audio-btn');
  if (audioBtn) {
    audioBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      const items = VOCAB_DATA[activeCat];
      const current = items[cardIdx];
      speakEnglish(current.en);
    });
  }

  const prevBtn = document.getElementById('en-prev-btn');
  if (prevBtn) {
    prevBtn.addEventListener('click', () => {
      const items = VOCAB_DATA[activeCat];
      cardIdx = (cardIdx - 1 + items.length) % items.length;
      renderCurrentCard();
    });
  }

  const nextBtn = document.getElementById('en-next-btn');
  if (nextBtn) {
    nextBtn.addEventListener('click', () => {
      const items = VOCAB_DATA[activeCat];
      cardIdx = (cardIdx + 1) % items.length;
      renderCurrentCard();
    });
  }

  const knownBtn = document.getElementById('en-known-btn');
  if (knownBtn) {
    knownBtn.addEventListener('click', () => {
      AudioFX.playChime();
      showStarToast(0, 'Super gemerkt!');
      triggerConfetti();
      const items = VOCAB_DATA[activeCat];
      cardIdx = (cardIdx + 1) % items.length;
      renderCurrentCard();
    });
  }

  renderCurrentCard();
</script>
