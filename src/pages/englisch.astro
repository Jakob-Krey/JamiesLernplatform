---
import BaseLayout from '../layouts/BaseLayout.astro';
import { VOCAB_CATEGORIES } from '../data/vocab';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="Jamies Englisch-Abenteuer 🇬🇧 • Quiz" activePage="englisch">
  <main class="container" style="padding-top: 2rem;">
    <!-- Breadcrumb / Back Link -->
    <div style="margin-bottom: 1.5rem;">
      <a href={`${base}/`} style="text-decoration: none; color: var(--color-primary); font-weight: 700; display: inline-flex; align-items: center; gap: 0.4rem;">
        <span>⬅️</span> Zurück zum Stundenplan
      </a>
    </div>

    <!-- Header Section -->
    <div style="text-align: center; max-width: 650px; margin: 0 auto 1.5rem;">
      <h1 style="font-size: 2rem; font-weight: 900; color: #0f172a; margin: 0 0 1rem;">
        Englisch-Quiz 🇬🇧
      </h1>

      <!-- Category Filter Buttons -->
      <div style="display: flex; justify-content: center; flex-wrap: wrap; gap: 0.5rem;" id="category-filter-bar">
        {VOCAB_CATEGORIES.map((cat, idx) => (
          <button 
            type="button" 
            class:list={['switch-btn', { active: idx === 0 }]} 
            data-cat={cat.id}
          >
            {cat.label}
          </button>
        ))}
        <button type="button" class="switch-btn" data-cat="alle">🎲 Alles gemischt</button>
      </div>

      <!-- Richtung (nur Quiz) -->
      <div style="display: flex; justify-content: center; gap: 0.5rem; margin-top: 0.75rem;" id="dir-bar">
        <button type="button" class="switch-btn active" data-dir="en-de">🇬🇧 ➔ 🇩🇪 Was heißt das?</button>
        <button type="button" class="switch-btn" data-dir="de-en">🇩🇪 ➔ 🇬🇧 Wie sagt man …?</button>
      </div>
    </div>

    <!-- Quiz -->
    <div id="quiz-area">
      <div class="math-game-box">
        <div style="display: flex; justify-content: space-between; align-items: center;">
          <span style="font-weight: 800; font-size: 0.85rem; color: #64748b; text-transform: uppercase;" id="quiz-tag">Quiz</span>
          <span style="background: #fef3c7; color: #b45309; padding: 0.25rem 0.65rem; border-radius: 9999px; font-weight: 800; font-size: 0.85rem;" id="quiz-streak">🔥 Serie: 0</span>
        </div>
        <div style="font-size: 4rem; margin-top: 1rem;" id="quiz-emoji">🐶</div>
        <div class="math-equation" id="quiz-word" style="font-size: 2.6rem; margin: 0.5rem 0 0.75rem;">Dog</div>
        <button type="button" class="flashcard-audio-btn" id="quiz-audio-btn" title="Englisch vorlesen" style="position: static; margin: 0 auto 1.5rem;">🔊 Vorlesen</button>
        <div class="math-options-grid" id="quiz-options"></div>
      </div>
    </div>

  </main>
</BaseLayout>

<script>
  import { VOCAB_DATA, type VocabCategoryId, type VocabItem } from '../data/vocab';
  import { StorageService } from '../lib/storage';
  import { AudioFX, speakEnglish, triggerConfetti, showStarToast } from '../lib/audio';

  type CatId = VocabCategoryId | 'alle';
  let activeCat: CatId = 'tiere';
  let dir: 'en-de' | 'de-en' = 'en-de';
  let streak = 0;
  let current: VocabItem | null = null;

  const ALL_ITEMS: VocabItem[] = Object.values(VOCAB_DATA).flat();

  function getItems(): VocabItem[] {
    return activeCat === 'alle' ? ALL_ITEMS : VOCAB_DATA[activeCat];
  }

  function shuffle<T>(arr: T[]): T[] {
    return [...arr].sort(() => Math.random() - 0.5);
  }

  function updateStreak() {
    const el = document.getElementById('quiz-streak');
    if (el) el.textContent = `🔥 Serie: ${streak}`;
  }

  function nextQuestion() {
    const pool = getItems();
    // nicht zweimal dasselbe Wort hintereinander
    let pick = pool[Math.floor(Math.random() * pool.length)];
    if (pool.length > 1) while (pick === current) pick = pool[Math.floor(Math.random() * pool.length)];
    current = pick;

    // Falsche Antworten bevorzugt aus der gleichen Kategorie, sonst aus allen Wörtern
    const text = (v: VocabItem) => (dir === 'en-de' ? v.de : v.en);
    const usable = (v: VocabItem) => v !== pick && text(v) !== text(pick);
    const wrongPool = [...shuffle(pool.filter(usable)), ...shuffle(ALL_ITEMS.filter((v) => usable(v) && !pool.includes(v)))].filter(
      (v, i, a) => a.findIndex((x) => text(x) === text(v)) === i
    );
    const options = shuffle([pick, ...wrongPool.slice(0, 3)]);

    document.getElementById('quiz-emoji')!.textContent = pick.emoji;
    document.getElementById('quiz-word')!.textContent = dir === 'en-de' ? pick.en : pick.de;
    document.getElementById('quiz-tag')!.textContent = dir === 'en-de' ? 'Was heißt das auf Deutsch?' : 'Wie sagt man das auf Englisch?';
    (document.getElementById('quiz-audio-btn') as HTMLElement).style.display = dir === 'en-de' ? 'inline-flex' : 'none';

    const box = document.getElementById('quiz-options')!;
    box.innerHTML = '';
    options.forEach((opt) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'math-opt-btn';
      btn.style.fontSize = '1.25rem';
      btn.textContent = text(opt);
      btn.onclick = () => answer(opt === pick, btn);
      box.appendChild(btn);
    });
  }

  function answer(correct: boolean, btn: HTMLButtonElement) {
    if (correct) {
      btn.classList.add('correct');
      streak++;
      updateStreak();
      AudioFX.playChime();
      if (dir === 'de-en' && current) speakEnglish(current.en);
      if (streak % 5 === 0) {
        StorageService.addStars(2);
        showStarToast(2, `${streak}er Serie! Du bist ein Englisch-Profi! 🌟`);
        triggerConfetti();
      } else {
        StorageService.addStars(1);
        showStarToast(1, 'Richtig! Well done! 🎯');
      }
      document.querySelectorAll<HTMLButtonElement>('#quiz-options .math-opt-btn').forEach((b) => (b.disabled = true));
      setTimeout(nextQuestion, 900);
    } else {
      btn.classList.add('wrong');
      streak = 0;
      updateStreak();
      setTimeout(() => btn.classList.remove('wrong'), 500);
    }
  }

  document.getElementById('quiz-audio-btn')?.addEventListener('click', () => {
    if (current) speakEnglish(current.en);
  });

  document.querySelectorAll('#category-filter-bar .switch-btn').forEach((btn) =>
    btn.addEventListener('click', () => {
      activeCat = btn.getAttribute('data-cat') as CatId;
      streak = 0;
      updateStreak();
      document.querySelectorAll('#category-filter-bar .switch-btn').forEach((b) => b.classList.toggle('active', b === btn));
      nextQuestion();
    })
  );

  document.querySelectorAll('#dir-bar .switch-btn').forEach((b) =>
    b.addEventListener('click', () => {
      dir = b.getAttribute('data-dir') as 'en-de' | 'de-en';
      streak = 0;
      updateStreak();
      document.querySelectorAll('#dir-bar .switch-btn').forEach((x) => x.classList.toggle('active', x === b));
      nextQuestion();
    })
  );

  nextQuestion();
</script>
