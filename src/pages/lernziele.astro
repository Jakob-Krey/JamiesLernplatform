---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  PLAN_DAYS,
  DONE_DAYS,
  WEEK_TITLES,
  SCHREIB_TOTAL,
  MATHE_TOTAL,
  dailyQuota
} from '../data/lernplan';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const WEEKDAYS = ['So', 'Mo', 'Di', 'Mi', 'Do', 'Fr', 'Sa'];
const dateLabel = (date: string) => {
  const [y, m, day] = date.split('-').map(Number);
  const weekday = WEEKDAYS[new Date(y, m - 1, day).getDay()];
  return `${weekday} ${String(day).padStart(2, '0')}.${String(m).padStart(2, '0')}.`;
};

// Schon erledigte Tage vor dem Start des Pfads (feste Häkchen)
const earlier = DONE_DAYS.map((d, i) => ({
  ...d,
  number: i + 1,
  label: dateLabel(d.date),
  newWeek: i === 0 || DONE_DAYS[i - 1].week !== d.week
}));

const days = PLAN_DAYS.map((d, i) => {
  const prevWeek = i === 0 ? earlier[earlier.length - 1]?.week : PLAN_DAYS[i - 1].week;
  return {
    ...d,
    index: i,
    number: earlier.length + i + 1,
    label: dateLabel(d.date),
    schreibQuota: dailyQuota(SCHREIB_TOTAL, i),
    matheQuota: dailyQuota(MATHE_TOTAL, i),
    newWeek: prevWeek !== d.week
  };
});
---

<BaseLayout title="Jamies Lernziele 🏔️ • Der Weg zur Mathearbeit" activePage="lernziele">
  <main class="container" style="padding-top: 2rem;">

    <div style="margin-bottom: 1.5rem;">
      <a href={`${base}/`} style="text-decoration: none; color: var(--color-primary); font-weight: 700; display: inline-flex; align-items: center; gap: 0.4rem;">
        <span>⬅️</span> Zurück zum Stundenplan
      </a>
    </div>

    <!-- Vertikaler Lernpfad -->
    <section class="path" aria-label="Lernpfad bis zur Mathearbeit">
      {earlier.map((d) => (
        <>
          {d.newWeek && (
            <div class="week-banner">
              <span class="week-line"></span>
              <span class="week-pill">🏔️ {WEEK_TITLES[d.week]}</span>
              <span class="week-line"></span>
            </div>
          )}
          <div class="path-node is-done" data-date={d.date}>
            <div class="node-circle" aria-hidden="true">
              <span class="node-icon">{d.number}</span>
            </div>
            <div class="node-text">
              <div class="node-date">{d.label}</div>
              <div class="node-topic">{d.topic}</div>
              <div class="node-quota">
                <span class="quota-chip">✓ erledigt</span>
                <span class="reward-chip">⭐ +{d.reward}</span>
              </div>
            </div>
          </div>
        </>
      ))}

      {days.map((d) => (
        <>
          {d.newWeek && (
            <div class="week-banner">
              <span class="week-line"></span>
              <span class="week-pill">🏔️ {WEEK_TITLES[d.week]}</span>
              <span class="week-line"></span>
            </div>
          )}
          <div class="path-node" data-index={d.index} data-date={d.date} data-reward={d.reward}>
            <div class="node-circle" aria-hidden="true">
              <span class="node-icon">{d.number}</span>
            </div>
            <div class="node-text">
              <div class="node-date">
                {d.label}
                <span class="today-pill" hidden>Heute</span>
                <span class="catchup-pill" hidden>aufholen</span>
              </div>
              <div class="node-topic">{d.topic}</div>
              {d.sheet && (
                <a class="sheet-link" href={`${base}/uebungen/?thema=${d.sheet}&seed=${d.date}`}>📝 Übungsblatt öffnen</a>
              )}
              <div class="node-quota">
                <span class="quota-chip q-schreib" data-quota={d.schreibQuota}>✍️ <b class="q-val">0</b>/{d.schreibQuota}</span>
                <span class="quota-chip q-mathe" data-quota={d.matheQuota}>🔢 <b class="q-val">0</b>/{d.matheQuota}</span>
                <span class="reward-chip">⭐ +{d.reward}</span>
              </div>
            </div>
          </div>
        </>
      ))}

      <div class="week-banner">
        <span class="week-line"></span>
        <span class="week-pill goal-pill">🏁 Ziel</span>
        <span class="week-line"></span>
      </div>
      <div class="path-node goal-node" id="goal-node">
        <div class="node-circle"><span class="node-icon">🏆</span></div>
        <div class="node-text">
          <div class="node-topic">Alle Seiten geschafft</div>
          <div class="node-quota">
            <span class="goal-chip">✍️ <b id="goal-schreib">0</b> / {SCHREIB_TOTAL} Seiten Schreiblernheft</span>
            <span class="goal-chip">🔢 <b id="goal-mathe">0</b> / {MATHE_TOTAL} Seiten Mathe</span>
          </div>
        </div>
      </div>
    </section>


    <!-- Eingabezeilen: werden per Skript in den aktuellen Tag verschoben -->
    <div id="entry-holder" hidden>
    <div class="entry-list" id="entry-controls">
      <div class="entry-row entry-orange">
        <div class="entry-name">✍️ Schreiblernheft<small id="schreib-current-text">Seite 35 von 76</small></div>
        <div class="entry-btns">
          <button type="button" class="btn-step" id="schreib-minus-btn" aria-label="Eine Seite zurück">−</button>
          <button type="button" class="btn-add" id="schreib-plus-btn">+ 1 Seite</button>
        </div>
      </div>

      <div class="entry-row entry-yellow">
        <div class="entry-name">🟡 Gelbes Flex &amp; Floh<small id="mathe-yellow-text">0 von 17 Seiten</small></div>
        <div class="entry-btns">
          <button type="button" class="btn-step" id="mathe-yellow-minus-btn" aria-label="Eine Seite zurück">−</button>
          <button type="button" class="btn-add" id="mathe-yellow-plus-btn">+ 1 Seite</button>
        </div>
      </div>

      <div class="entry-row entry-blue">
        <div class="entry-name">🔵 Blaues Flex &amp; Floh<small id="mathe-blue-text">0 von 17 Seiten</small></div>
        <div class="entry-btns">
          <button type="button" class="btn-step" id="mathe-blue-minus-btn" aria-label="Eine Seite zurück">−</button>
          <button type="button" class="btn-add" id="mathe-blue-plus-btn">+ 1 Seite</button>
        </div>
      </div>
    </div>
      <p class="entry-hint">Sterne gibt es, wenn alle Seiten des Tages erledigt sind (Deutsch <em>und</em> Mathe).</p>
    </div>
  </main>
</BaseLayout>

<style>
  .panel {
    background: white;
    border: 2px solid #e2e8f0;
    border-radius: 24px;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
    box-shadow: var(--shadow-md);
  }
  .panel-head { display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin-bottom: 1rem; }
  .panel-title { font-size: 1.3rem; font-weight: 900; color: #0f172a; margin: 0; }
  .hint { margin: 0 0 1rem; color: #64748b; font-size: 0.9rem; line-height: 1.5; }

  .entry-list { display: flex; flex-direction: column; gap: 0.45rem; margin-top: 0.6rem; }
  .entry-hint { margin: 0.4rem 0 0; color: #64748b; font-size: 0.75rem; line-height: 1.4; }
  .entry-row {
    display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem;
    border-radius: 14px; padding: 0.4rem 0.6rem 0.4rem 0.8rem; border: 2px solid;
  }
  .entry-orange { background: #fff7ed; border-color: #fed7aa; }
  .entry-yellow { background: #fefce8; border-color: #fef08a; }
  .entry-blue { background: #eff6ff; border-color: #bfdbfe; }
  .entry-name { font-weight: 800; color: #1e293b; display: flex; flex-direction: column; font-size: 0.9rem; }
  .entry-name small { font-weight: 600; color: #64748b; font-size: 0.82rem; }
  .entry-btns { display: flex; gap: 0.5rem; align-items: center; }
  .btn-step {
    width: 36px; height: 36px; border-radius: 10px; border: 2px solid #cbd5e1;
    background: white; font-size: 1.15rem; font-weight: 900; color: #475569; cursor: pointer;
  }
  .btn-add {
    height: 36px; padding: 0 0.9rem; border-radius: 10px; border: none;
    background: var(--color-primary); color: white; font-weight: 800; font-size: 0.85rem; cursor: pointer;
    box-shadow: 0 3px 0 var(--color-primary-dark);
  }
  .btn-add:active { transform: translateY(2px); box-shadow: 0 1px 0 var(--color-primary-dark); }
  .btn-add:disabled { opacity: 0.45; cursor: default; }

  /* Vertikaler Pfad */
  .path {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 2rem auto 4rem;
    max-width: 520px;
  }
  .week-banner { display: flex; align-items: center; gap: 0.75rem; width: 100%; margin: 1.25rem 0 0.75rem; }
  .week-line { flex: 1; height: 2px; background: #e2e8f0; }
  .week-pill {
    background: #4f46e5; color: white; font-weight: 800; font-size: 0.95rem;
    padding: 0.55rem 1.2rem; border-radius: 9999px; text-align: center;
  }
  .goal-pill { background: #f59e0b; color: #78350f; }

  .path-node {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1rem;
    width: 100%;
    padding: 0.9rem 0;
  }
  /* gepunktete Verbindung zum nächsten Knoten */
  .path-node::after {
    content: '';
    position: absolute;
    left: 31px;
    top: calc(50% + 32px);
    bottom: calc(-50% + 32px);
    border-left: 4px dotted #cbd5e1;
  }
  .path-node:last-child::after { display: none; }

  .node-circle {
    flex: 0 0 64px;
    width: 64px; height: 64px;
    border-radius: 50%;
    background: #e2e8f0;
    color: #64748b;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.4rem; font-weight: 900;
    box-shadow: 0 5px 0 #cbd5e1;
    z-index: 1;
  }
  .node-text { display: flex; flex-direction: column; gap: 0.15rem; min-width: 0; }
  .node-date { font-size: 0.82rem; font-weight: 700; color: #94a3b8; display: flex; gap: 0.4rem; align-items: center; flex-wrap: wrap; }
  .node-topic { font-size: 1.05rem; font-weight: 800; color: #94a3b8; line-height: 1.25; }
  .node-quota { display: flex; gap: 0.4rem; flex-wrap: wrap; margin-top: 0.3rem; }
  .quota-chip, .reward-chip, .goal-chip {
    font-size: 0.78rem; font-weight: 800; border-radius: 9999px; padding: 0.15rem 0.6rem;
    background: #f1f5f9; color: #64748b;
  }
  .reward-chip { background: #fef3c7; color: #b45309; }
  .goal-chip { font-size: 0.85rem; padding: 0.25rem 0.75rem; }
  .goal-chip b { font-weight: 900; }
  .sheet-link {
    align-self: flex-start; margin-top: 0.2rem; font-size: 0.85rem; font-weight: 800; color: #4f46e5;
    text-decoration: none; border-bottom: 2px solid #c7d2fe;
  }
  .sheet-link:hover { border-bottom-color: #4f46e5; }
  .today-pill, .catchup-pill { font-size: 0.7rem; font-weight: 900; padding: 0.1rem 0.5rem; border-radius: 9999px; text-transform: uppercase; }
  .today-pill { background: #6366f1; color: white; }
  .catchup-pill { background: #ffedd5; color: #c2410c; }

  /* Zustände */
  .path-node.is-done .node-circle { background: #22c55e; color: white; box-shadow: 0 5px 0 #15803d; }
  .path-node.is-done .node-icon { font-size: 0; }
  .path-node.is-done .node-icon::before { content: '✓'; font-size: 1.9rem; }
  .path-node.is-done .node-topic { color: #1e293b; }
  .path-node.is-done .node-date { color: #64748b; }
  .path-node.is-done .quota-chip { background: #dcfce7; color: #15803d; }
  .path-node.is-done .reward-chip { background: #fde68a; }

  .path-node.is-current .node-circle {
    background: #6366f1; color: white; box-shadow: 0 5px 0 #4338ca;
    animation: node-pulse 1.8s ease-in-out infinite;
  }
  .path-node.is-current .node-topic { color: #0f172a; font-size: 1.15rem; }
  .path-node.is-current .node-date { color: #4f46e5; }
  .path-node.is-current .quota-chip { background: #e0e7ff; color: #3730a3; }

  .goal-node .node-circle { background: #fde68a; color: #92400e; box-shadow: 0 5px 0 #f59e0b; font-size: 1.8rem; }
  .goal-node .node-topic { color: #0f172a; }
  .goal-node.is-reached .node-circle { background: #22c55e; box-shadow: 0 5px 0 #15803d; }

  @keyframes node-pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.08); }
  }

  /* leichter Zickzack auf größeren Bildschirmen */
  @media (min-width: 640px) {
    .path-node:nth-of-type(odd) { transform: translateX(-24px); }
    .path-node:nth-of-type(even) { transform: translateX(24px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .path-node.is-current .node-circle { animation: none; }
  }
</style>

<script>
  import { StorageService } from '../lib/storage';
  import { AudioFX, triggerConfetti, showStarToast } from '../lib/audio';
  import { PLAN_DAYS, DONE_DAYS, SCHREIB_TOTAL, MATHE_TOTAL, cumulativeTarget } from '../data/lernplan';

  const YELLOW_TOTAL = 17;
  const BLUE_TOTAL = 17;

  function localDateStr(d = new Date()): string {
    const mm = String(d.getMonth() + 1).padStart(2, '0');
    const dd = String(d.getDate()).padStart(2, '0');
    return `${d.getFullYear()}-${mm}-${dd}`;
  }

  const $ = (id: string) => document.getElementById(id);

  function progress() {
    const sg = StorageService.getSchreibheftGoal();
    const mg = StorageService.getMatheGoal();
    const schreibDone = Math.min(SCHREIB_TOTAL, Math.max(0, sg.currentPage - sg.startPage));
    const matheDone = Math.min(MATHE_TOTAL, mg.yellowDoneTotal + mg.blueDoneTotal);
    return { sg, mg, schreibDone, matheDone };
  }

  /** Ein Tag ist geschafft, wenn alle Seiten bis einschließlich dieses Tages erledigt sind. */
  function isDayDone(index: number, schreibDone: number, matheDone: number): boolean {
    return (
      schreibDone >= cumulativeTarget(SCHREIB_TOTAL, index) &&
      matheDone >= cumulativeTarget(MATHE_TOTAL, index)
    );
  }

  function claimRewards(schreibDone: number, matheDone: number) {
    let earned = 0;
    // Bereits erledigte Tage vor dem Pfad
    DONE_DAYS.forEach((day) => {
      if (StorageService.claimDay(day.date)) {
        StorageService.addStars(day.reward);
        earned += day.reward;
      }
    });
    PLAN_DAYS.forEach((day, i) => {
      if (isDayDone(i, schreibDone, matheDone) && StorageService.claimDay(day.date)) {
        StorageService.addStars(day.reward);
        earned += day.reward;
      }
    });
    if (earned > 0) {
      AudioFX.playSuccessFanfare();
      triggerConfetti();
      showStarToast(earned, 'Tagesziel geschafft! Alle Seiten erledigt 🏆');
    }
  }

  function render() {
    const { sg, mg, schreibDone, matheDone } = progress();
    const today = localDateStr();

    // Eingabe-Zeilen
    $('schreib-current-text')!.textContent = `Seite ${sg.currentPage} von ${sg.targetPage}`;
    $('mathe-yellow-text')!.textContent = `${mg.yellowDoneTotal} von ${YELLOW_TOTAL} Seiten`;
    $('mathe-blue-text')!.textContent = `${mg.blueDoneTotal} von ${BLUE_TOTAL} Seiten`;
    ($('schreib-plus-btn') as HTMLButtonElement).disabled = sg.currentPage >= sg.targetPage;
    ($('mathe-yellow-plus-btn') as HTMLButtonElement).disabled = mg.yellowDoneTotal >= YELLOW_TOTAL;
    ($('mathe-blue-plus-btn') as HTMLButtonElement).disabled = mg.blueDoneTotal >= BLUE_TOTAL;

    // Pfad
    let currentSet = false;
    document.querySelectorAll<HTMLElement>('.path-node[data-index]').forEach((node) => {
      const i = Number(node.dataset.index);
      const date = node.dataset.date!;
      const dayDone = isDayDone(i, schreibDone, matheDone);
      node.classList.toggle('is-done', dayDone);
      const isCurrent = !dayDone && !currentSet;
      node.classList.toggle('is-current', isCurrent);
      if (isCurrent) currentSet = true;

      (node.querySelector('.today-pill') as HTMLElement).hidden = date !== today;
      (node.querySelector('.catchup-pill') as HTMLElement).hidden = !(date < today && !dayDone);

      // Fortschritt dieses Tages in den Chips
      const prevS = i === 0 ? 0 : cumulativeTarget(SCHREIB_TOTAL, i - 1);
      const prevM = i === 0 ? 0 : cumulativeTarget(MATHE_TOTAL, i - 1);
      const sChip = node.querySelector<HTMLElement>('.q-schreib')!;
      const mChip = node.querySelector<HTMLElement>('.q-mathe')!;
      const sq = Number(sChip.dataset.quota);
      const mq = Number(mChip.dataset.quota);
      sChip.querySelector('.q-val')!.textContent = String(Math.min(sq, Math.max(0, schreibDone - prevS)));
      mChip.querySelector('.q-val')!.textContent = String(Math.min(mq, Math.max(0, matheDone - prevM)));
    });

    // Eingabezeilen direkt in den aktuellen Tag setzen (oder ins Ziel, wenn alles geschafft ist)
    const controls = $('entry-controls');
    const host = document.querySelector<HTMLElement>('.path-node.is-current .node-text') ?? $('goal-node')?.querySelector<HTMLElement>('.node-text');
    if (controls && host && controls.parentElement !== host) host.appendChild(controls);
    const hint = document.querySelector('.entry-hint');
    if (hint && host && hint.parentElement !== host) host.appendChild(hint);

    // Ziel ganz unten: nötige Seitenzahl je Fach
    $('goal-schreib')!.textContent = String(schreibDone);
    $('goal-mathe')!.textContent = String(matheDone);
    $('goal-node')!.classList.toggle('is-reached', schreibDone >= SCHREIB_TOTAL && matheDone >= MATHE_TOTAL);
  }

  function change(fn: () => void, praise?: string) {
    fn();
    const { schreibDone, matheDone } = progress();
    if (praise) AudioFX.playChime();
    claimRewards(schreibDone, matheDone);
    render();
  }

  $('schreib-plus-btn')?.addEventListener('click', () =>
    change(() => {
      const g = StorageService.getSchreibheftGoal();
      if (g.currentPage < g.targetPage) StorageService.setSchreibheftCurrentPage(g.currentPage + 1);
    }, 'ok')
  );
  $('schreib-minus-btn')?.addEventListener('click', () =>
    change(() => {
      const g = StorageService.getSchreibheftGoal();
      if (g.currentPage > g.startPage) StorageService.setSchreibheftCurrentPage(g.currentPage - 1);
    })
  );
  $('mathe-yellow-plus-btn')?.addEventListener('click', () =>
    change(() => {
      if (StorageService.getMatheGoal().yellowDoneTotal < YELLOW_TOTAL) StorageService.updateMatheGoal({ yellow: 1 });
    }, 'ok')
  );
  $('mathe-yellow-minus-btn')?.addEventListener('click', () =>
    change(() => {
      if (StorageService.getMatheGoal().yellowDoneTotal > 0) StorageService.updateMatheGoal({ yellow: -1 });
    })
  );
  $('mathe-blue-plus-btn')?.addEventListener('click', () =>
    change(() => {
      if (StorageService.getMatheGoal().blueDoneTotal < BLUE_TOTAL) StorageService.updateMatheGoal({ blue: 1 });
    }, 'ok')
  );
  $('mathe-blue-minus-btn')?.addEventListener('click', () =>
    change(() => {
      if (StorageService.getMatheGoal().blueDoneTotal > 0) StorageService.updateMatheGoal({ blue: -1 });
    })
  );

  // Änderungen von anderen Geräten (Firebase) sofort anzeigen
  window.addEventListener('jamie-storage-update', (e: any) => {
    const t = e.detail?.type;
    if (t === 'goal_schreibheft' || t === 'goal_mathe' || t === 'claimed_days') render();
  });

  {
    const { schreibDone, matheDone } = progress();
    claimRewards(schreibDone, matheDone);
  }
  render();
  // Beim Öffnen direkt zum aktuellen Tag springen
  (document.querySelector('.path-node.is-current') ?? $('goal-node'))?.scrollIntoView({ block: 'center' });
</script>
