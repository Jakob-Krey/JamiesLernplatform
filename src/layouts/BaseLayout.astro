---
import Navigation from '../components/Navigation.astro';
import StarCounter from '../components/StarCounter.astro';
import CloudSyncModal from '../components/CloudSyncModal.astro';
import { PROFILES, PROFILE_IDS, manifestFile } from '../lib/profile';
import '../styles/style.css';
import '../styles/cards.css';
import '../styles/animations.css';

interface Props {
  title?: string;
  description?: string;
  activePage?: 'stundenplan' | 'deutsch' | 'mathe' | 'englisch' | 'pokemon' | 'lernziele' | 'timer' | 'uebungen';
}

const {
  title = "Jamies Lernplattform 🎒 • Stundenplan & Lernwelten",
  description = "Jamies persönliche Schul- und Lernplattform mit interaktivem Stundenplan, Ranzen-Checker, Lernkarten für Deutsch, Mathe, Englisch und Pokémon-Sammelalbum.",
  activePage = 'stundenplan'
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Sichtbarkeit je Kind: Elemente mit data-profiles="jamie maya" erscheinen nur bei diesen Kindern.
const profileCss =
  PROFILE_IDS.map(
    (id) => `html[data-kind="${id}"] [data-profiles]:not([data-profiles~="${id}"]) { display: none !important; }
html[data-kind="${id}"] [data-switch="${id}"] { background: #4f46e5; color: #fff; border-color: #4f46e5; }`
  ).join('\n');

const profileClient = {
  ids: PROFILE_IDS,
  base,
  active: activePage,
  pages: Object.fromEntries(PROFILE_IDS.map((id) => [id, PROFILES[id].pages])),
  manifests: Object.fromEntries(PROFILE_IDS.map((id) => [id, `${base}/${manifestFile(id)}`])),
  icons: Object.fromEntries(PROFILE_IDS.map((id) => [id, `${base}/icons/${id === 'jamie' ? '' : id + '-'}apple-touch-icon.png`])),
  names: Object.fromEntries(PROFILE_IDS.map((id) => [id, PROFILES[id].name])),
  emojis: Object.fromEntries(PROFILE_IDS.map((id) => [id, PROFILES[id].emoji]))
};
---

<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />

  <!-- Web-App (PWA) -->
  <link rel="manifest" id="manifest-link" href={`${base}/manifest.webmanifest`} />
  <meta name="theme-color" content="#6366f1" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-title" content="Jamie lernt" />
  <meta name="apple-mobile-web-app-status-bar-style" content="default" />
  <link rel="icon" type="image/png" href={`${base}/icons/icon-192.png`} />
  <link rel="apple-touch-icon" id="touch-icon-link" href={`${base}/icons/apple-touch-icon.png`} />
  <style is:inline set:html={profileCss}></style>
  <!-- Kind bestimmen (?kind=maya), bevor die Seite gezeigt wird -->
  <script is:inline define:vars={{ pc: profileClient }}>
    (function () {
      var k = null;
      try {
        var q = new URLSearchParams(location.search).get('kind');
        q = q ? q.toLowerCase() : null;
        if (q && pc.ids.indexOf(q) > -1) { k = q; localStorage.setItem('jamie_profile', q); }
        else { k = localStorage.getItem('jamie_profile'); }
      } catch (e) {}
      if (!k || pc.ids.indexOf(k) < 0) k = 'jamie';
      document.documentElement.setAttribute('data-kind', k);
      // Seiten, die zu diesem Kind nicht gehören (z. B. Lernziele bei Maya), führen zum Start
      if (pc.pages[k].indexOf(pc.active) < 0) { location.replace(pc.base + '/'); return; }
      var m = document.getElementById('manifest-link'); if (m) m.setAttribute('href', pc.manifests[k]);
      var t = document.getElementById('touch-icon-link'); if (t) t.setAttribute('href', pc.icons[k]);
      var a = document.querySelector('meta[name="apple-mobile-web-app-title"]'); if (a) a.setAttribute('content', pc.names[k] + ' lernt');
      if (k !== 'jamie') document.title = document.title.replace(/Jamies/g, pc.names[k] + 's').replace(/Jamie/g, pc.names[k]).replace(/🎒/g, pc.emojis[k]);
    })();
  </script>

  <!-- Google Fonts: Outfit & Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet" />
</head>
<body>

  <!-- Floating animated background elements -->
  <div class="bg-decoration" aria-hidden="true">
    <div class="blob blob-1"></div>
    <div class="blob blob-2"></div>
    <div class="blob blob-3"></div>
  </div>

  <!-- Top Sticky Navigation Bar -->
  <header class="site-header">
    <div class="container nav-wrapper">
      <a href={`${base}/`} class="brand" aria-label="Zur Startseite">
        <div class="brand-icon"><span data-profiles="jamie">🎒</span><span data-profiles="maya">🦄</span></div>
        <div class="brand-title">
          <span data-profiles="jamie">Jamie's</span><span data-profiles="maya">Maya's</span>
          <span class="brand-subtitle">Lernplattform 🌟</span>
        </div>
      </a>

      <Navigation activePage={activePage} />

      <div class="header-actions" style="display: flex; align-items: center; gap: 0.65rem;">
        <!-- Live Focus Timer Pill -->
        <a 
          href={`${base}/timer/`} 
          id="global-timer-pill" 
          class="timer-pill" 
          title="Fokus-Timer öffnen"
          style="display: inline-flex; align-items: center; gap: 0.35rem; background: #f8fafc; border: 1.5px solid #e2e8f0; padding: 0.35rem 0.75rem; border-radius: 9999px; text-decoration: none; font-size: 0.85rem; font-weight: 800; color: #475569; transition: all 0.2s;"
        >
          <span id="global-timer-icon">⏱️</span>
          <span id="global-timer-text">15:00</span>
        </a>

        <StarCounter />
      </div>
    </div>
  </header>

  <!-- Main Content Container -->
  <slot />

  <!-- Cloud Sync / Backup Modal -->
  <CloudSyncModal />

  <!-- Footer -->
  <footer class="site-footer" style="padding: 1.25rem 0; margin-top: 3rem;">
    <div class="container footer-content" style="text-align: center;">
      <p style="font-weight: 800; font-size: 0.95rem; color: #64748b; margin: 0;">
        Für <span data-profiles="jamie" style="color: #ec4899;">Jamie</span><span data-profiles="maya" style="color: #ec4899;">Maya</span> ❤️
      </p>
      <p style="font-size: 0.72rem; color: #94a3b8; margin: 0.4rem 0 0;">
        Fan-Projekt ohne Gewinnabsicht. Pokémon © Nintendo / Creatures / Game Freak. Bilder von PokéAPI.
      </p>
    </div>
  </footer>

  <script>
    import { StorageService } from '../lib/storage';
    import { AudioFX, triggerConfetti, showStarToast, speakEnglish } from '../lib/audio';
    import { FocusTimerService } from '../lib/focusTimer';

    FocusTimerService.init();

    // Expose to window for inline onclick handlers if needed
    (window as any).StorageService = StorageService;
    (window as any).AudioFX = AudioFX;
    (window as any).triggerConfetti = triggerConfetti;
    (window as any).showStarToast = showStarToast;
    (window as any).speakEnglish = speakEnglish;
    (window as any).FocusTimerService = FocusTimerService;

    // Update global timer pill in header
    const pillEl = document.getElementById('global-timer-pill');
    const textEl = document.getElementById('global-timer-text');
    const iconEl = document.getElementById('global-timer-icon');

    function updateHeaderPill(state: any) {
      if (!textEl || !iconEl || !pillEl) return;
      textEl.textContent = FocusTimerService.formatTime(state.timeLeft);

      if (state.mode === 'work') {
        iconEl.textContent = state.isRunning ? '🎯' : '⏱️';
        if (state.isRunning) {
          pillEl.style.background = '#eff6ff';
          pillEl.style.borderColor = '#93c5fd';
          pillEl.style.color = '#1d4ed8';
          pillEl.style.boxShadow = '0 0 0 3px rgba(59, 130, 246, 0.15)';
        } else {
          pillEl.style.background = '#f8fafc';
          pillEl.style.borderColor = '#e2e8f0';
          pillEl.style.color = '#475569';
          pillEl.style.boxShadow = 'none';
        }
      } else {
        iconEl.textContent = '🍎';
        if (state.isRunning) {
          pillEl.style.background = '#ecfdf5';
          pillEl.style.borderColor = '#a7f3d0';
          pillEl.style.color = '#047857';
          pillEl.style.boxShadow = '0 0 0 3px rgba(16, 185, 129, 0.15)';
        } else {
          pillEl.style.background = '#f0fdf4';
          pillEl.style.borderColor = '#bbf7d0';
          pillEl.style.color = '#15803d';
          pillEl.style.boxShadow = 'none';
        }
      }
    }

    updateHeaderPill(FocusTimerService.getState());
    window.addEventListener('jamie-timer-tick', (e: any) => updateHeaderPill(e.detail));
  </script>
  <script is:inline define:vars={{ swUrl: `${base}/sw.js`, swScope: `${base}/` }}>
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register(swUrl, { scope: swScope }).catch(() => {});
      });
    }
  </script>
</body>
</html>
