---
// StarCounter.astro
---

<div class="star-counter-wrapper" style="display: flex; align-items: center; gap: 0.5rem;">
  <div 
    class="star-counter" 
    id="star-btn" 
    title="Klicke für einen Bonus-Stern!"
    style="cursor: pointer;"
  >
    <span class="star-icon">⭐</span>
    <span id="jamie-star-count">0</span>
    <span style="font-size: 0.75rem; text-transform: uppercase;">Sterne</span>
  </div>

  <button 
    type="button" 
    class="sync-btn" 
    id="open-sync-btn"
    title="Fortschritt speichern & sichern"
    style="background: rgba(255, 255, 255, 0.85); border: 2px solid #fed7aa; border-radius: 9999px; width: 38px; height: 38px; display: inline-flex; align-items: center; justify-content: center; font-size: 1.05rem; cursor: pointer; transition: all 0.2s ease; box-shadow: 0 2px 5px rgba(0,0,0,0.05);"
    aria-label="Cloud & Backup Einstellungen"
  >
    ☁️
  </button>
</div>

<script>
  import { StorageService } from '../lib/storage';
  import { AudioFX, triggerConfetti, showStarToast } from '../lib/audio';

  function updateDisplay() {
    const el = document.getElementById('jamie-star-count');
    if (el) {
      el.textContent = StorageService.getStars().toString();
    }
  }

  // Initial load
  updateDisplay();

  // Listen to storage update events
  window.addEventListener('jamie-storage-update', (e: any) => {
    if (e.detail?.type === 'stars') {
      const el = document.getElementById('jamie-star-count');
      if (el) el.textContent = e.detail.data.toString();
    }
  });

  const starBtn = document.getElementById('star-btn');
  if (starBtn) {
    starBtn.addEventListener('click', () => {
      StorageService.addStars(1);
      AudioFX.playChime();
      showStarToast(1, 'Du fleißige Lernerin!');
      triggerConfetti();
    });
  }

  const syncBtn = document.getElementById('open-sync-btn');
  if (syncBtn) {
    syncBtn.addEventListener('click', () => {
      const modal = document.getElementById('cloud-sync-modal');
      if (modal) modal.classList.add('is-open');
    });
  }
</script>
